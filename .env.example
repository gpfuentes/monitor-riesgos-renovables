# .env.example — PLANTILLA de las variables de entorno del proyecto. SIN valores reales.
#
# Cómo se usa:
#   1. Copia este archivo:  cp .env.example .env
#   2. Rellena los valores en .env (ese archivo está en .gitignore y nunca se sube).
#   3. En GitHub Actions, estos mismos nombres se guardan como GitHub Secrets.
#
# Si añades una variable nueva al proyecto, añádela aquí también (vacía) para que
# cualquiera sepa qué necesita configurar.

# --- Incendios: NASA FIRMS (Fase 1) ------------------------------------------
# Clave gratuita: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# --- Rayos: EUMETSAT Data Store (Fase 2) --------------------------------------
# Registro gratuito en https://eoportal.eumetsat.int ; las credenciales de API
# se ven en https://api.eumetsat.int/api-key/
EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=

# --- Avisos: AEMET OpenData (Fase 2) ------------------------------------------
# Clave gratuita: https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_API_KEY=

# --- Alertas: bot de Telegram (Fase 3) ----------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- IA: API del LLM (Fase 3) — ÚNICO servicio de pago, con límite de gasto ----
LLM_API_KEY=

# --- Databricks ---------------------------------------------------------------
# En el Mac NO hace falta: la CLI se autentica con OAuth y guarda su perfil en
# ~/.databrickscfg. Estas variables solo las usará GitHub Actions (Fase 1).
DATABRICKS_HOST=
DATABRICKS_TOKEN=
